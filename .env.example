# Supabase (the Vercel Supabase integration sets these)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI
OPENAI_API_KEY=
# One model per pipeline step; override any of them without code changes.
# Find the form page among faxed pages (cheap, low-detail images)
OPENAI_MODEL_CLASSIFY=gpt-5.4-nano
# Read every field from the form page
OPENAI_MODEL_EXTRACT=gpt-5.4-mini
# Re-read only the fields the first pass was unsure about
OPENAI_MODEL_REREAD=gpt-5.5
# Fields below this confidence (0-1) get re-read and highlighted for review
EXTRACT_REREAD_THRESHOLD=0.75
