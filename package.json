{
  "name": "intake-form",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "node scripts/copy-pdf-worker.mjs",
    "eval": "EVAL=1 vitest run test/eval.test.ts",
    "eval:criteria": "EVAL_CRITERIA=1 vitest run test/criteria-eval.test.ts",
    "samples": ".venv/bin/python scripts/make_samples.py",
    "packets": ".venv/bin/python scripts/make_packets.py",
    "packets:random": ".venv/bin/python scripts/make_packets.py --random",
    "setup:python": "python3 -m venv .venv && .venv/bin/pip install -r scripts/requirements.txt",
    "mock": "MOCK_SQL=1 vitest run test/mock-data.test.ts",
    "deps": "depcruise app components lib test scripts",
    "deps:graph": "node scripts/deps-graph.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "next": "^16.4.0",
    "openai": "^7.32.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dependency-cruiser": "^18.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
