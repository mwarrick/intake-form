#!/usr/bin/env bash
# Start the dev server in the background. Logs go to .cache/dev.log; ./stop stops it.
set -euo pipefail
cd "$(dirname "$0")"

PORT="${PORT:-3000}"
PID_FILE=.cache/dev.pid
LOG_FILE=.cache/dev.log
mkdir -p .cache

if [[ -f "$PID_FILE" ]] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
  echo "Already running (pid $(cat "$PID_FILE")) at http://localhost:$PORT"
  exit 0
fi

if lsof -nP -iTCP:"$PORT" -sTCP:LISTEN >/dev/null 2>&1; then
  echo "Port $PORT is already in use. Set PORT to use another, e.g. PORT=3001 ./start"
  exit 1
fi

[[ -d node_modules ]] || npm install

nohup npx next dev -p "$PORT" >"$LOG_FILE" 2>&1 &
echo $! >"$PID_FILE"

# Wait up to 30 seconds for the server to answer.
for _ in $(seq 30); do
  if curl -s -o /dev/null "http://localhost:$PORT"; then
    echo "Running at http://localhost:$PORT (pid $(cat "$PID_FILE"), log $LOG_FILE)"
    exit 0
  fi
  if ! kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
    echo "The server exited. Last lines of $LOG_FILE:"
    tail -20 "$LOG_FILE"
    rm -f "$PID_FILE"
    exit 1
  fi
  sleep 1
done
echo "Started (pid $(cat "$PID_FILE")) but not answering yet; see $LOG_FILE"
